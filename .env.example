# Exemple de configuration d'environnement pour CovoitGo (aucun secret réel)
SPRING_PROFILES_ACTIVE=prod
API_PORT=8080
MONGO_PORT=27017
MONGODB_URI=mongodb://utilisateur_prod:mot_de_passe_secret@mongodb:27017/covoitgo_prod?authSource=admin
JWT_SECRET=votre_cle_secrete_jwt_change_me_super_securisee_256bits_minimum
